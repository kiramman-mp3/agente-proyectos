# ============================================================
#  Configuración del Agente de Seguimiento de Proyectos
#  Copia este archivo como .env y completa los valores.
#  Las credenciales (Trello, GitHub, OpenRouter) NO van aquí:
#  se guardan cifradas con:  python -m app.cli set-secret <nombre>
# ============================================================

# Clave maestra para cifrar credenciales (generar con: python -m app.cli gen-key)
MASTER_KEY=
# Secreto para firmar los tokens de sesión (JWT). Cualquier cadena larga aleatoria.
JWT_SECRET=
JWT_EXPIRE_HOURS=12

DB_PATH=data/agente.db

# ---------- Base de datos ----------
# Vacío: SQLite local en DB_PATH. Con una URL de PostgreSQL (p. ej. Neon) se usa esa base.
DATABASE_URL=

# ---------- Correo para retrasos críticos ----------
# smtp: Gmail con contraseña de aplicación (credencial cifrada: set-secret smtp_password). Algunos hostings bloquean SMTP.
# apps_script: relé HTTPS con Google Apps Script (deploy/apps_script_mailer.gs; credencial: mail_webhook_secret).
# Los avisos van al correo de los usuarios con rol gestor.
MAIL_TRANSPORT=
SMTP_USER=
MAIL_WEBHOOK_URL=

# ---------- Proveedor de IA ----------
# openrouter: muchos modelos con una sola API key (https://openrouter.ai/models)
#   ej.: anthropic/claude-sonnet-4.5, openai/gpt-4.1-mini, google/gemini-3.5-flash
# gemini:     API directa de Google (https://aistudio.google.com/apikey), tiene nivel gratuito
#   ej.: gemini-3.8-flash, gemini-3.5-flash (los Pro no están en el nivel gratuito; revisa los vigentes en https://ai.google.dev/gemini-api/docs/models)
# La credencial correspondiente se guarda con: python -m app.cli set-secret openrouter_api_key | gemini_api_key
LLM_PROVIDER=openrouter
MODEL_EXECUTOR=anthropic/claude-sonnet-4.5
MODEL_REVIEWER=openai/gpt-4.1-mini
MODEL_APPROVER=openai/gpt-4.1-mini
# Proveedor de respaldo: se usa solo si el principal falla (cuota, 429, 5xx, red o credencial ausente).
# Los modelos se nombran distinto en cada proveedor, por eso van aparte. Vacío: sin respaldo.
LLM_FALLBACK_PROVIDER=
FALLBACK_MODEL_EXECUTOR=
FALLBACK_MODEL_REVIEWER=
FALLBACK_MODEL_APPROVER=

# ---------- Trello ----------
TRELLO_BOARD_ID=
# Nombres de listas (separados por coma, sin distinguir mayúsculas) que indican el estado
LISTS_PENDING=Pendiente,Por hacer,To Do,Backlog
LISTS_IN_PROGRESS=En progreso,En ejecución,Doing,In Progress
LISTS_DONE=Hecho,Completado,Terminado,Done
LISTS_BLOCKED=Bloqueado,Blocked
# Etiqueta que marca una tarjeta como bloqueada
BLOCKED_LABEL=Bloqueado
# Etiquetas de prioridad (de mayor a menor)
PRIORITY_LABELS=Alta,Media,Baja

# ---------- GitHub ----------
GITHUB_REPO=usuario/repositorio
# Rama a revisar: la de integración (p. ej. develop), no la de producción
GITHUB_BRANCH=develop

# ---------- Reglas de seguimiento ----------
# Días antes del vencimiento a partir de los cuales una actividad se considera "en riesgo"
RISK_DAYS=3
TIMEZONE=America/Guayaquil

# ---------- Planificador automático ----------
SCHEDULER_ENABLED=true
ANALYSIS_INTERVAL_MINUTES=60
CODE_REVIEW_INTERVAL_HOURS=24
# Reporte semanal: día (mon..sun) y hora
REPORT_DAY=mon
REPORT_HOUR=8

# ---------- Seguridad y operación ----------
# Documentación interactiva en /docs (y /openapi.json). Déjala en false en producción.
ENABLE_DOCS=false
# Intentos fallidos de login permitidos por usuario dentro de la ventana (la IP admite 4 veces más)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
# Retención de datos en días (0 = no purgar). La bitácora de auditoría se conserva por defecto.
AUDIT_RETENTION_DAYS=0
SNAPSHOT_RETENTION_DAYS=90
CHANGES_RETENTION_DAYS=180
NOTIFICATION_RETENTION_DAYS=90
