{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    },
    "ios-altstore": {
      "distribution": "internal",
      "ios": {
        "withoutCredentials": true,
        "config": "unsigned-ipa.yml"
      }
    }
  }
}
